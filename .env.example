# Gemini API Key (required for Signal Monitor, Causal Propagation, Temporal Reasoner, Alert Composer)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional alias used by ADK runtime (if omitted, server maps GEMINI_API_KEY -> GOOGLE_API_KEY)
GOOGLE_API_KEY=your-gemini-api-key-here
# Optional ADK model override
ADK_MODEL=gemini-2.5-flash

# Server port
PORT=3001
