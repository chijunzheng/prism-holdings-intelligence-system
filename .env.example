# Gemini API Key (required for Signal Monitor, Causal Propagation, Temporal Reasoner, Alert Composer)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional alias used by ADK runtime (if omitted, server maps GEMINI_API_KEY -> GOOGLE_API_KEY)
GOOGLE_API_KEY=your-gemini-api-key-here
# Optional ADK model override
ADK_MODEL=gemini-3-flash-preview
# Optional fast-path overrides for Signal Monitor / Causal Propagation (defaults to gemini-2.5-flash-lite)
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# Session naming and signal monitor use GEMINI_FAST_MODEL for low latency
# GEMINI_SIGNAL_MODEL=gemini-2.5-flash-lite
# GEMINI_CAUSAL_MODEL=gemini-2.5-flash-lite
# Optional verbose tracing for signals/graph pipelines in backend logs
# DEBUG_IMPACT_TRACE=1
# PRISM_TRACE=1
# PRISM_TRACE_LLM=1
# DEBUG_SIGNAL_MONITOR_VERBOSE=1
# Optional: treat empty ADK signal list as valid (disables manual fallback)
# PRISM_ADK_EMPTY_SIGNAL_IS_VALID=0

# Server port
PORT=3001
