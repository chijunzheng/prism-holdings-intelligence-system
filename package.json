{
  "name": "prism-holdings-intelligence-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "shared",
    "agents",
    "server",
    "data"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:frontend\"",
    "dev:frontend": "pnpm --filter @prism/frontend dev",
    "dev:server": "pnpm --filter @prism/server dev",
    "build": "pnpm --filter @prism/shared build && pnpm --filter @prism/frontend build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}